#!/bin/bash
#PBS -N fow-labels
#PBS -q serial
#PBS -l select=1:ncpus=1:mem=15gb
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o /hpctmp/tommy.21.31/fow/logs/

# Solver-label collection by self-play, one array task per block of games.
#
# Submit:  qsub -J 1-10 -v TAG=labels-01,GAMES=12,BUDGET_MS=1000 label_arm.pbs
#
# Each task writes pair_c/runs/<TAG>/task-<N>/ with its own seed base
# (SEED_BASE + 1000*N), manifest and validator report, so tasks never share a
# part file and a killed task resumes from its finished games. Pair B's loader
# takes a folder of part files; the task folders are validated separately and
# merged by copying parts, or pointed at one by one.
#
# Code is repo-labels, a copy of pair-a/solver-labels at 30b5753: label() open,
# label_run.py, tail_guard.py. repo/ and repo-mech/ are read live by the other
# arrays and are not touched. Atlas labels and homelab labels are the same
# protocol on different platforms; they can be pooled for training, since a
# label is a (belief, value) pair and not a paired game outcome.
#
# max_states 300000 is the guard sized for this 15 GiB cgroup (item 20).
set -u

: "${TAG:?submit with -v TAG=labels-01,GAMES=12}"
GAMES=${GAMES:-12}
BUDGET_MS=${BUDGET_MS:-1000}
SEED_BASE=${SEED_BASE:-5001}
MAX_STATES=${MAX_STATES:-300000}
SAMPLE=${SAMPLE:-16}

ROOT=/hpctmp/$USER/fow
cd "$ROOT/repo-labels"
source "$ROOT/env.sh"
export PYTHONPATH=$ROOT/repo-labels/pair_b/src:$ROOT/experiment

SEED=$((SEED_BASE + 1000 * PBS_ARRAY_INDEX))
OUT="pair_c/runs/${TAG}/task-${PBS_ARRAY_INDEX}"
echo "[$(date -Is)] labels ${TAG} task ${PBS_ARRAY_INDEX} on $(hostname) code=repo-labels@30b5753 games=$GAMES seed=$SEED budget_ms=$BUDGET_MS max_states=$MAX_STATES"
grep -m1 "model name" /proc/cpuinfo
python -c "import pair_a_prep.label_run, pair_a_prep.tail_guard; print(\"label runner importable\")"

/usr/bin/time -v python -m pair_a_prep.label_run --out "$OUT" --games "$GAMES" --seed "$SEED" \
    --evaluator material --time-budget-ms "$BUDGET_MS" --max-plies 200 \
    --max-states "$MAX_STATES" --sample-size "$SAMPLE" --commit 30b5753
status=$?
echo "[$(date -Is)] labels ${TAG} task ${PBS_ARRAY_INDEX} exit=$status"
exit $status
