#!/bin/bash
#PBS -N fow-labels-sf8
#PBS -q serial
#PBS -l select=1:ncpus=1:mem=15gb
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o /hpctmp/tommy.21.31/fow/logs/

# Solver-label collection by self-play with a Stockfish 14.1 depth-8 leaf, one array task
# per block of games. Same protocol as labels-01 (16 sampled roots, 96k tail guard, 200-ply
# cap, 2-8 unlabelled opening plies, both colours labelled) except the leaf and the clock.
#
# Why depth 8 / 30 s / growth window 0.85 (homelab smokes, 2026-11-09): a depth-8 call costs
# ~0.08 s on real positions (depth 10: ~0.5 s). Tree construction needs one call per sampled
# root plus one per retained-tree repair; over the 19,749 labels-01 records that is p50 16,
# p95 86, p99 200, max 705 calls. A move whose construction outruns the clock yields no label
# ("budget exhausted during tree construction"), so with depth 8 a 30 s clock (27 s hard stop
# ~ 270 calls) loses well under 1% of moves; 20 s lost 2 of 14 in the smoke game, and
# depth 10 lost 3 of 14 even at 60 s. expansion_fraction 0.85 lets the tree keep growing
# until 25.5 s; the last 3 s are solver rounds only.
#
# Code: repo-exp = pair-a/experiments-20261108 (6995d6c; includes the Stockfish
# en-passant-under-check fix, #68) plus label_run.py's --leaf-depth,
# --stockfish-call-timeout-s and --expansion-fraction flags. Engine: $ROOT/bin/stockfish,
# built on the login node from the sf_14.1 source with GCC 13.3.0 (ARCH=x86-64-avx2;
# compute nodes are EPYC 7R13).
#
# Submit the array:
#   qsub -J 1-20 -v TAG=labels-sf8,GAMES=12,BUDGET_MS=30000,MAX_STATES=96000,SEED_BASE=50001 label_sf8.pbs
# Resubmit one dead task (finished parts are skipped, so it resumes):
#   qsub -v TAG=labels-sf8,GAMES=12,BUDGET_MS=30000,MAX_STATES=96000,SEED_BASE=50001,N=7 label_sf8.pbs
#
# SEED_BASE 50001 keeps the seeds disjoint from labels-01 (5001 + 1000*N on Atlas, 5001 + 2i on homelab).
set -u

: "${TAG:?submit with -v TAG=labels-sf8,GAMES=12,...}"
GAMES=${GAMES:-12}
BUDGET_MS=${BUDGET_MS:-30000}
SEED_BASE=${SEED_BASE:-50001}
MAX_STATES=${MAX_STATES:-96000}
SAMPLE=${SAMPLE:-16}
DEPTH=${DEPTH:-8}
CALL_TIMEOUT=${CALL_TIMEOUT:-10}
EXPANSION=${EXPANSION:-0.85}
TASK=${PBS_ARRAY_INDEX:-${N:?submit with -v ...,N=<task index>}}

ROOT=/hpctmp/$USER/fow
cd "$ROOT/repo-exp"
source "$ROOT/env.sh"
export PYTHONPATH=$ROOT/repo-exp/pair_b/src:$ROOT/experiment
SF=$ROOT/bin/stockfish
SF_SHA=222fa1bde9c66c80fae891a0082863d8eb71b5021304e77c3f3b964f90c5e604

SEED=$((SEED_BASE + 1000 * TASK))
OUT="pair_c/runs/${TAG}/task-${TASK}"
echo "[$(date -Is)] labels ${TAG} task ${TASK} on $(hostname) code=repo-exp@6995d6c+label-flags games=$GAMES seed=$SEED budget_ms=$BUDGET_MS expansion_fraction=$EXPANSION leaf=stockfish depth=$DEPTH call_timeout_s=$CALL_TIMEOUT max_states=$MAX_STATES out=$OUT"
grep -m1 "model name" /proc/cpuinfo
python -c "import pair_a_prep.label_run, pair_a_prep.tail_guard, pairb.stockfish; print(\"label runner importable\")"
(echo uci; echo quit) | "$SF" | grep -m1 "id name"

/usr/bin/time -v python -m pair_a_prep.label_run --out "$OUT" --games "$GAMES" --seed "$SEED" \
    --evaluator stockfish --stockfish "$SF" --stockfish-sha256 "$SF_SHA" \
    --leaf-depth "$DEPTH" --stockfish-call-timeout-s "$CALL_TIMEOUT" \
    --time-budget-ms "$BUDGET_MS" --expansion-fraction "$EXPANSION" --max-plies 200 \
    --max-states "$MAX_STATES" --sample-size "$SAMPLE" --commit "6995d6c+label-flags"
status=$?
echo "[$(date -Is)] labels ${TAG} task ${TASK} exit=$status"
exit $status
